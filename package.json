{
  "name": "ultrawork-ai",
  "version": "1.0.0",
  "description": "UltraWork AI Platform - Multi-Agent AI Skill System",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "start:legacy": "node server/staticServer.js",
    "dev": "nodemon server/index.js",
    "lint": "npx eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:mcp": "playwright test tests/e2e/mcp-ui-simplified.spec.js",
    "test:mcp:integration": "node tests/integration/mcp-client.test.js",
    "test:mcp-client": "node tests/integration/mcp-client.test.js",
    "test:mcp:e2e": "playwright test tests/e2e/mcp-ui.spec.js",
    "test:integration": "node scripts/run-integration-tests.js",
    "test:brainstorm-server": "node tests/brainstorm-server/server-test.js",
    "mcp:start": "node scripts/mcp-integration.js",
    "mcp:agent": "node examples/mcp/mcp-agent-example.js",
    "mcp:workflow": "node examples/mcp/mcp-workflow-example.js",
    "mcp:log-workflow": "node examples/mcp/mcp-log-analysis-workflow.js",
    "learn-eval": "node -e \"require('./src/learnEval').run()\"",
    "serve-frontend": "node server/staticServer.js",
    "start-prod": "NODE_ENV=production node server/staticServer.js",
    "start-prod-windows": "set NODE_ENV=production && node server/staticServer.js",
    "uw": "node scripts/uw.js",
    "uw:governance": "node scripts/uw.js phase11:governance",
    "uw:update": "node scripts/uw.js phase11:update",
    "uw:coord": "node scripts/uw.js phase12:coord",
    "uw:security": "node scripts/uw.js phase13:security",
    "uw:perf": "node scripts/uw.js phase14:perf",
    "uw:test": "node scripts/uw.js phase15:test",
    "uw:all": "node scripts/uw.js all",
    "security:monitor": "node scripts/security-monitor.js",
    "security:score": "node scripts/security-score.js",
    "audit": "npm audit --registry=https://registry.npmjs.org",
    "security:gate": "npm run audit && echo 'Security gate PASSED'",
    "security:audit": "npm run security:monitor && npm run security:score",
    "security:scan": "node scripts/security-scan.js",
    "security:all": "npm run security:scan && npm run security:gate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/server-everything": "^2026.1.26",
    "@modelcontextprotocol/server-filesystem": "^2026.1.14",
    "@modelcontextprotocol/server-sequential-thinking": "^2025.12.18",
    "@playwright/test": "^1.58.2",
    "eslint-plugin-security": "4.0.1",
    "husky": "9.1.7",
    "jest": "^29.7.0",
    "jsdom": "^29.0.1",
    "lint-staged": "17.0.8",
    "sharp": "^0.35.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^6.3.4",
    "typescript": "6.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ]
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.1",
    "@pixiv/three-vrm-animation": "^3.5.1",
    "@xenova/transformers": "^2.17.2",
    "bcrypt": "^6.0.0",
    "chokidar": "5.0.0",
    "chromadb": "^3.4.0",
    "compression": "^1.8.1",
    "discord.js": "^14.25.1",
    "docx": "^9.6.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "js-yaml": "4.3.0",
    "jsonwebtoken": "^9.0.3",
    "mineflayer": "^4.35.0",
    "mineflayer-pathfinder": "^2.4.5",
    "ollama": "^0.6.3",
    "otplib": "^13.4.0",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "three": "^0.183.2",
    "winston": "^3.19.0"
  },
  "lint-staged": {
    "*.js": [
      "node scripts/security-scan.js --incremental",
      "npx eslint --max-warnings=0 --no-warn-ignored"
    ]
  },
  "overrides": {
    "protobufjs": "8.6.4",
    "uuid": "11.1.1",
    "js-yaml": "4.3.0",
    "brace-expansion": "2.1.2",
    "@hono/node-server": "2.0.11",
    "babel-plugin-istanbul": {
      "@istanbuljs/load-nyc-config": {
        "js-yaml": "4.3.0"
      }
    },
    "discord.js": {
      "undici": "6.27.0",
      "@discordjs/rest": {
        "undici": "6.27.0"
      }
    },
    "@discordjs/ws": {
      "@discordjs/rest": {
        "undici": "6.27.0"
      }
    }
  }
}

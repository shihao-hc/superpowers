# OpenCode Multi-Stage Dockerfile
# Optimized for production deployment with security best practices

# Stage 1: Dependencies
FROM node:20-alpine AS deps
WORKDIR /app

RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    && rm -rf /var/cache/apk/*

COPY package*.json ./
RUN npm ci --only=production

# Stage 2: Development
FROM node:20-alpine AS development
WORKDIR /app

RUN apk add --no-cache \
    git \
    curl \
    bash \
    python3 \
    make \
    g++

COPY package*.json ./
RUN npm ci

COPY . .

ENV NODE_ENV=development
ENV PORT=3000

EXPOSE 3000

CMD ["npm", "run", "dev"]

# Stage 3: Build
FROM node:20-alpine AS builder
WORKDIR /app

RUN apk add --no-cache \
    python3 \
    make \
    g++

COPY package*.json ./
RUN npm ci

COPY . .

ENV NODE_ENV=production
ENV PORT=3000

RUN npm run build || true

# Stage 4: Production
FROM node:20-alpine AS production

LABEL maintainer="OpenCode AI"
LABEL description="OpenCode AI Agent Platform - Production"

WORKDIR /app

RUN apk add --no-cache \
    dumb-init \
    curl \
    ca-certificates \
    ttf-freefont \
    && rm -rf /var/cache/apk/*

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV NODE_ENV=production
ENV PORT=3000
ENV PUPPETEER_NO_SANDBOX=true

COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./

# Create non-root user for security
RUN addgroup -g 1001 -S opencode && \
    adduser -S opencode -u 1001 -G opencode

RUN mkdir -p /app/.opencode /app/data /app/screenshots && \
    chown -R opencode:opencode /app/.opencode /app/data /app/screenshots

USER opencode

VOLUME ["/app/.opencode", "/app/data", "/app/screenshots"]

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:3000/api/health || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server/index.js"]
